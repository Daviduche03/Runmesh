# --- server -----------------------------------------------------------------
PORT=8787
HOST=0.0.0.0
LOG_LEVEL=info
DB_PATH=/data/runmesh.db

# --- required ----------------------------------------------------------------
# Signs dashboard sessions and webhook signatures. Rotating it invalidates
# every session and every in-flight webhook signature.
JWT_SECRET=replace-with-a-long-random-string

# --- URLs ---------------------------------------------------------------------
# PUBLIC_URL must be the address callers reach the API on; it is used for
# OAuth redirect targets.
PUBLIC_URL=http://localhost:8787
FRONTEND_URL=http://localhost:5173

# --- optional integrations ----------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CONNECT_CLIENT_ID=
GOOGLE_CONNECT_CLIENT_SECRET=
# Enables OTP email delivery via Resend. Codes are never logged.
RESEND_API_KEY=

# --- runtime tuning (defaults are fine) ---------------------------------------
SWEEP_INTERVAL_SECONDS=5
QUEUE_POLL_INTERVAL_SECONDS=1
