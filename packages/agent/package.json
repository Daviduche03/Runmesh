{
  "name": "@runmesh/agent",
  "version": "0.1.0",
  "description": "Runmesh wrapper for agent SDKs: definition capture, run lifecycle, and tool I/O telemetry. Observe-only in v0 — no enforcement.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bench": "node bench/wrap.bench.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.13.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
