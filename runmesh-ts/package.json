{
  "name": "runmesh-ts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Runmesh API server — Node/TS port of runmesh-main (FastAPI + SQLite)",
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "smoke": "bun scripts/smoke.ts",
    "e2e": "bun scripts/e2e.ts"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "http-errors": "^2.0.1",
    "jose": "^6.2.13",
    "nunjucks": "^3.2.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/http-errors": "^2.0.5",
    "@types/node": "^26.6.5",
    "@types/nunjucks": "^3.2.6",
    "typescript": "~5.9.3"
  }
}
